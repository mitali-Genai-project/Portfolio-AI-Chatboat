# Copy to .env.local for local development (git-ignored), and set the same
# variables in Vercel > Project > Settings > Environment Variables.
# None of these are exposed to the browser: they have no VITE_ prefix and are
# only read by the serverless function in api/chat.ts.
# NEVER put a real key in this file — it is committed to git.

# Which LLM answers chat questions: gemini (default) | mock
# "mock" returns canned replies and needs no key (local UI work).
CHAT_PROVIDER=gemini

# --- Google Gemini ---------------------------------------------------------
# Required. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier model. Default: gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded or out of free quota.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# --- Shared limits (optional) ----------------------------------------------
# Max tokens per reply. Default: 2048.
CHAT_MAX_OUTPUT_TOKENS=2048
# Upstream request timeout in ms. Default: 25000 (function maxDuration is 30 s).
CHAT_TIMEOUT_MS=25000
# Requests per minute per IP, per server instance. Default: 10.
CHAT_RATE_LIMIT_PER_MINUTE=10
# Extra origins allowed to call the API, comma-separated (same-origin always allowed).
# e.g. https://example.com,https://www.example.com
CHAT_ALLOWED_ORIGINS=
